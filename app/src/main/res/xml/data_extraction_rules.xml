<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: back up the user's data (database, preferences, avatar); caches are excluded by default. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <include domain="file" path="avatar/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <include domain="file" path="avatar/" />
    </device-transfer>
</data-extraction-rules>
